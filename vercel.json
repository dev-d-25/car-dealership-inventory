{
  "version": 2,
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "pnpm --filter client build",
  "outputDirectory": "client/dist",
  "framework": null,
  "functions": {
    "server/src/app.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server/src/app.ts"
    }
  ]
}
