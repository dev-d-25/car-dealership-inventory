{
  "version": 2,
  "installCommand": "corepack enable && pnpm install",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/src/app.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server/src/**", "server/drizzle/**"]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/src/app.ts"
    }
  ]
}
